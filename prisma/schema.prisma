// Mô hình dữ liệu cho Lucky Money.
// Quy ước: tiền là Int (VND), thời gian lưu UTC, mọi bảng dữ liệu người dùng đều có userId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Tùy chọn hiển thị (Cài đặt > Tùy chỉnh tài chính). Tiền vẫn luôn là VND số nguyên.
enum AmountFormat {
  SYMBOL // 50.000 ₫
  DONG // 50.000 đ
  SHORT // 50k
}

enum DateFormat {
  DMY // 24/11/2026
  ISO // 2026-11-24
}

enum WeekStart {
  MONDAY
  SUNDAY
}

// Sổ nợ: "Tôi nợ" người khác, hoặc người khác "nợ tôi".
enum DebtDirection {
  I_OWE
  THEY_OWE
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String? // họ tên
  username     String?  @unique // tên hiển thị duy nhất (@minh); đăng nhập vẫn bằng email
  birthDate    String? // "YYYY-MM-DD"
  passwordHash String? // null nếu chỉ đăng nhập bằng Google
  timeZone     String   @default("Asia/Ho_Chi_Minh")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  amountFormat        AmountFormat    @default(SYMBOL)
  dateFormat          DateFormat      @default(DMY)
  weekStart           WeekStart       @default(MONDAY)
  theme               ThemePreference @default(SYSTEM)
  notifyBudgetWarning Boolean         @default(true) // cảnh báo khi dùng 80% ngân sách
  notifyBudgetOver    Boolean         @default(true) // cảnh báo khi vượt ngân sách
  notifyDebtEmail     Boolean         @default(true) // email nhắc kỳ trả nợ sắp đến hạn / quá hạn

  avatar       UserAvatar?
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  debts        Debt[]
}

// Ảnh đại diện (đã cắt vuông, 256x256) tách bảng riêng để truy vấn User không phải tải ảnh.
model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Dùng cho Google OAuth (Auth.js Prisma adapter).
// Phiên đăng nhập dùng JWT nên không cần bảng Session.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType // danh mục thuộc thu hay chi
  icon      String? // emoji hoặc tên icon
  deletedAt DateTime? // đã xóa nhưng còn giao dịch đã xóa mềm trỏ tới; ẩn khỏi mọi nơi
  createdAt DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id         String          @id @default(cuid())
  userId     String
  categoryId String
  type       TransactionType
  amount     Int // VND, > 0, tối đa 1_000_000_000 (kiểm tra bằng Zod)
  occurredAt DateTime // thời điểm phát sinh (UTC)
  note       String?
  deletedAt  DateTime? // xóa mềm
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([userId, categoryId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      String // định dạng "YYYY-MM"
  amount     Int // hạn mức VND
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

// Sổ nợ: không phải thu/chi, nên tách khỏi Transaction và không vào thống kê.
// Ngày là ngày lịch theo múi giờ của user ("YYYY-MM-DD"). Tiền là VND số nguyên.
model Debt {
  id           String        @id @default(cuid())
  userId       String
  direction    DebtDirection
  counterparty String // người cho vay / người vay
  principal    Int // tổng số tiền nợ
  startDate    String // "YYYY-MM-DD"
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments DebtInstallment[]
  payments     DebtPayment[]

  @@index([userId])
}

// Lịch trả dự kiến: tổng các kỳ = principal (kiểm tra ở service).
model DebtInstallment {
  id      String @id @default(cuid())
  debtId  String
  dueDate String // "YYYY-MM-DD"
  amount  Int

  // Email nhắc đã gửi cho kỳ này (mỗi loại một lần).
  upcomingRemindedAt DateTime?
  overdueRemindedAt  DateTime?

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId, dueDate])
}

// Các lần trả thực tế (có thể trả một phần).
model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  amount    Int
  paidOn    String // "YYYY-MM-DD"
  note      String?
  createdAt DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}
