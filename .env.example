# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection string. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://spendly:spendly@localhost:5432/spendly?schema=public"

# Separate databases for automated tests (created and migrated automatically).
# Integration tests TRUNCATE every table, so these must never point at real data.
TEST_DATABASE_URL="postgresql://spendly:spendly@localhost:5432/spendly_test?schema=public"
E2E_DATABASE_URL="postgresql://spendly:spendly@localhost:5432/spendly_e2e?schema=public"

# Auth.js: secret used to encrypt session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Trust the Host header when self-hosting (`next start`). Vercel sets this automatically.
AUTH_TRUST_HOST="true"

# Debt reminder emails (Sổ nợ). SMTP connection URL, e.g. Gmail with an app password:
#   smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# Empty in development: emails are printed to the server log instead.
SMTP_URL=""
EMAIL_FROM="Lucky Money <no-reply@example.com>"
# Public URL of the app, used for links in emails.
APP_URL="http://localhost:3000"
# Bearer token Vercel Cron sends to /api/cron/debt-reminders (daily, 08:00 Vietnam time).
# Generate like AUTH_SECRET. Without it the endpoint refuses every call.
CRON_SECRET=""

# "true": the daily cron also resets the public demo account (demo@example.com,
# see src/server/demo/demo-account.ts) to fresh sample data. Off when empty.
DEMO_ACCOUNT_RESET=""
